# Count Occurences of and element 

n = int(input("How many elements: "))

arr = []
count = 0 

for i in range (0,n):
    value = int(input(" "))
    arr.append(value)

print(arr)
targetnum = int(input("Enter target element :"))


for i in range (0, n ):
    if targetnum == arr[i]:
        count+= 1 


print(targetnum," Occurs:",count ,"times")

