num1 = int(input("Enter a number 1 :"))
num2 = int(input("Enter a number 2 :"))
gcd_num = 0

#  find smallest number to stop for loop 
if num1>num2:
  smaller=num2
else:
  smaller=num1

#print("smaller number : ",smaller)
for i in range (1,smaller+1):
  if num1 % i == 0 and num2 % i == 0 :
    gcd_num = i
print("GCD is : ",gcd_num)

